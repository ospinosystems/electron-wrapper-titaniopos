{
  "name": "titaniopos-electron",
  "version": "1.0.0",
  "description": "TitanioPOS Desktop - Wrapper Electron con impresión silenciosa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node prebuild.js",
    "bundle:frontend": "node bundle-frontend.js",
    "build": "npm run prebuild && npm run bundle:frontend && electron-builder --win --publish never",
    "build:portable": "npm run prebuild && npm run bundle:frontend && electron-builder --win portable --publish never",
    "release": "npm run prebuild && npm run bundle:frontend && electron-builder --win --publish always",
    "publish": "npm run prebuild && npm run bundle:frontend && electron-builder --win --publish always"
  },
  "author": "TitanioPOS",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.1.8",
    "@3ksy/electron-pos-printer": "^1.4.9",
    "bwip-js": "^4.8.0",
    "escpos": "^3.0.0-alpha.6",
    "escpos-buffer": "^4.1.0",
    "escpos-network": "^3.0.0-alpha.5",
    "escpos-usb": "^3.0.0-alpha.4",
    "jsonwebtoken": "^9.0.3",
    "node-thermal-printer": "^4.5.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.titaniopos.desktop",
    "productName": "TitanioPOS",
    "npmRebuild": false,
    "files": [
      "**/*",
      "!frontend-server/**",
      "!dist/**",
      "!dist-*/**"
    ],
    "asarUnpack": [
      "**/*.ico"
    ],
    "extraResources": [
      {
        "from": "frontend-server",
        "to": "frontend-server",
        "filter": ["**/*"]
      },
      {
        "from": "fiscal-server",
        "to": "fiscal-server",
        "filter": ["**/*", "!__pycache__/**", "!*.pyc"]
      },
      {
        "from": "python-embed",
        "to": "python-embed",
        "filter": ["**/*"]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": ["*.exe"]
      },
      {
        "from": "drivers",
        "to": "drivers",
        "filter": ["*.exe"]
      },
      {
        "from": "drivers/verifone",
        "to": "drivers/verifone",
        "filter": ["**/*"]
      },
      {
        "from": "vpos-rest",
        "to": "vpos-rest",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ospinosystems",
        "repo": "electron-wrapper-titaniopos",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "executableName": "TitanioPOS",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "TitanioPOS-Setup.${ext}",
      "shortcutName": "TitanioPOS",
      "uninstallDisplayName": "TitanioPOS",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "TitanioPOS-Portable.${ext}"
    },
    "forceCodeSigning": false
  }
}
