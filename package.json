{
  "name": "titaniopos-electron",
  "version": "1.0.72",
  "description": "TitanioPOS Desktop - Wrapper Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bundle:frontend": "node bundle-frontend.js",
    "build": "npm run bundle:frontend && electron-builder --win --publish never",
    "build:portable": "npm run bundle:frontend && electron-builder --win portable --publish never",
    "release": "npm run bundle:frontend && electron-builder --win --publish always",
    "publish": "npm run bundle:frontend && electron-builder --win --publish always",
    "start:local": "electron . --env=local",
    "start:prod": "electron . --env=prod"
  },
  "author": "TitanioPOS",
  "license": "MIT",
  "dependencies": {
    "bwip-js": "^4.8.0",
    "electron-updater": "^6.1.8",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.titaniopos.desktop",
    "productName": "TitanioPOS",
    "npmRebuild": false,
    "files": [
      "**/*",
      "!dist/**",
      "!dist-*/**",
      "!_view-host/**",
      "!_chat-backup/**",
      "!python-embed/**",
      "!fiscal-server/**",
      "!vpos-rest/**",
      "!drivers/**",
      "!**/*.zip",
      "!**/*.tar.gz",
      "!**/*.log",
      "!.env.bak"
    ],
    "asarUnpack": [
      "**/*.ico"
    ],
    "extraResources": [
      {
        "from": "caja-config.env",
        "to": ".env"
      },
      {
        "from": "fiscal-server",
        "to": "fiscal-server",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "python-embed",
        "to": "python-embed",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "drivers/verifone",
        "to": "drivers/verifone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vpos-rest",
        "to": "vpos-rest",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ospinosystems",
        "repo": "electron-wrapper-titaniopos",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "executableName": "TitanioPOS",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "TitanioPOS-Setup.${ext}",
      "shortcutName": "TitanioPOS",
      "uninstallDisplayName": "TitanioPOS",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "TitanioPOS-Portable.${ext}"
    },
    "forceCodeSigning": false
  }
}
