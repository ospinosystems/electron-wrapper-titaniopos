# ─────────────────────────────────────────────────────────────────────────────
# Config editable de la caja TitanioPOS  (queda en  resources/.env )
#
# Este archivo TIENE PRIORIDAD sobre el .env horneado en la app. Edita estas
# rutas para apuntar la caja a PROD (por defecto) o a LOCAL, SIN recompilar.
# Guarda el archivo y vuelve a abrir la caja.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (login + datos) ──────────────────────────────────────────────────
TITANIOPOS_BACKEND_URL="https://www.titanio-pos.com"
# LOCAL (Sail/Docker):  TITANIOPOS_BACKEND_URL="http://localhost:8080"

# ── Electric SQL (sync de catálogo) ──────────────────────────────────────────
TITANIOPOS_ELECTRIC_URL="https://electric.titanio-pos.com"
# LOCAL:  TITANIOPOS_ELECTRIC_URL="http://localhost:3000"

# ── Host de actualizaciones de la vista (hot-swap del frontend) ──────────────
TITANIOPOS_VIEW_UPDATE_URL="https://updates.titanio-pos.com"
# LOCAL (host de prueba):  TITANIOPOS_VIEW_UPDATE_URL="http://127.0.0.1:8090"

# ── Origen que el backend reconoce como stateful (Sanctum) ───────────────────
# Normalmente NO se cambia. Solo si el backend LOCAL usa otro dominio stateful.
TITANIOPOS_SPOOF_ORIGIN="https://frontend.titanio-pos.com"
