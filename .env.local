# ── Ambiente LOCAL (npm run start:local) ─────────────────────────────────────
# UI desde tu `next dev` (HMR) y backend/Electric locales. Estos valores GANAN
# sobre .env (se cargan primero y loadEnvFile no pisa lo ya seteado).

# UI en vivo desde el dev server del frontend (ajusta el puerto si usas otro).
TITANIOPOS_DEV_UI_URL=http://localhost:3001

# Backend Laravel local (Sail publica 80→80) y Electric local.
TITANIOPOS_BACKEND_URL=http://localhost:80
TITANIOPOS_ELECTRIC_URL=http://localhost:3000

# Updates de la vista APAGADOS en local (host inalcanzable a propósito).
TITANIOPOS_VIEW_UPDATE_URL=http://127.0.0.1:1

TITANIOPOS_OPEN_DEVTOOLS_ON_START=true
