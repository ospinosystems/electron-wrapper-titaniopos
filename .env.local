# ── Ambiente LOCAL (npm run start:local) ─────────────────────────────────────
# UI desde tu `next dev` (HMR) y backend/Electric locales. Estos valores GANAN
# sobre .env (se cargan primero y loadEnvFile no pisa lo ya seteado).
#
# :warning: Este archivo SOLO se carga con `npm run start:local` (= electron . --env=local).
#    Con `npm start` a secas se ignora por completo, y la app sirve la vista
#    DESCARGADA de %APPDATA%\titaniopos-electron\views en el puerto 3010:
#    nunca ves tu código local.

# ── Modo A (activo): UI directa desde el dev server ──────────────────────────
# Origen = http://localhost:3001. El frontend usa sus defaults
# (NEXT_PUBLIC_API_URL=http://localhost:80, NEXT_PUBLIC_ELECTRIC_URL=http://localhost:3000),
# que es justo lo que el backend local acepta por CORS y por SANCTUM_STATEFUL_DOMAINS.
# Costo: el origen difiere del de la caja real (127.0.0.1:3010), así que la sesión
# y la base local (Dexie/Electric) de dev viven aparte. Te logueás una vez y listo.
TITANIOPOS_URL=http://localhost:3001
TITANIOPOS_FRONTEND_MODE=remote

# ── Modo B (alternativo): dev server detrás del proxy local ──────────────────
# Conserva el origen 127.0.0.1:3010 de la caja real y ejercita el proxy
# /__backend + /__electric, que es el mismo camino que producción.
# `TITANIOPOS_DEV_UI_URL` lo lee frontend-server-manager.js:184 y corta ANTES de
# resolveServerDir(), así que la vista descargada queda fuera de juego.
# Para usarlo:
#   1. Comentá las dos líneas del Modo A.
#   2. Descomentá las dos de abajo.
#   3. En titaniopos-frontend/.env.local agregá:
#        NEXT_PUBLIC_API_URL=/__backend
#        NEXT_PUBLIC_ELECTRIC_URL=/__electric
#      (con eso el frontend deja de funcionar abierto directo en el navegador)
# TITANIOPOS_DEV_UI_URL=http://localhost:3001
# TITANIOPOS_FRONTEND_MODE=local

# Backend Laravel local (Sail publica 80→80) y Electric local.
TITANIOPOS_BACKEND_URL=http://localhost:80
TITANIOPOS_ELECTRIC_URL=http://localhost:3000

# Origin que el Sanctum LOCAL acepta como stateful (SANCTUM_STATEFUL_DOMAINS
# del backend local incluye localhost:3001; el spoof de prod da 401 acá).
TITANIOPOS_SPOOF_ORIGIN=http://localhost:3001

# Updates de la vista APAGADOS en local (host inalcanzable a propósito).
TITANIOPOS_VIEW_UPDATE_URL=http://127.0.0.1:1

TITANIOPOS_OPEN_DEVTOOLS_ON_START=true