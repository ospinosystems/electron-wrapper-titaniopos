<log4net>
    <appender name="Console" type="log4net.Appender.ConsoleAppender">
        <layout type="log4net.Layout.PatternLayout">
            <!-- Pattern to output the caller's file name and line number -->
            <conversionPattern value="%5level [%thread] (%file:%line) - %message%newline" />
        </layout>
    </appender>
    
    <appender name="Archivo" type="log4net.Appender.RollingFileAppender">
        <file value="D:/WrapperNET/TestRESTCards/TestRESTCards/logs/wrapper.log" />
        <appendToFile value="true" />
        <maximumFileSize value="2MB" />
        <maxSizeRollBackups value="4" />
		<rollingStyle value="Size" />
        <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%date %level %thread %logger (%file:%line) - %message%newline" />
        </layout>
    </appender>

	<appender name="Error" type="log4net.Appender.RollingFileAppender">
        <file value="D:/WrapperNET/TestRESTCards/TestRESTCards/logs/wrapper-error.log" />
        <appendToFile value="true" />
        <maximumFileSize value="2MB" />
        <maxSizeRollBackups value="4" />
		<rollingStyle value="Size" />
        <layout type="log4net.Layout.PatternLayout">
            <conversionPattern value="%date %level %thread %logger (%file:%line) - %message%newline" />
        </layout>
		<filter type="log4net.Filter.LevelRangeFilter">
		  <levelMin value="WARN" />
		  <levelMax value="FATAL" />
		</filter>
    </appender>
    
    <root>
        <level value="DEBUG"/>
        <appender-ref ref="Console" />
        <appender-ref ref="Archivo" />
		<appender-ref ref="Error" />
    </root>
</log4net>
