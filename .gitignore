# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node / dependencies
node_modules/
.pnp*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
out/
# NO ignoramos `build/` — nuestra carpeta build/ contiene assets de instalador
# NSIS que electron-builder necesita (package.json → nsis.include apunta a
# `build/installer.nsh`). Outputs de empaquetado van a dist/, no a build/.
release/
tmp/
temp/
.cache/
.parcel-cache/
*-unpacked/

# Electron packaging artifacts
*.AppImage
*.dmg
*.exe
*.msi
*.pkg
*.deb
*.rpm
*.snap
*.flatpak
*.asar
*.blockmap
*.zip

# Excepciones: binarios que SI van al repo porque son parte del bundle
!python-embed/**/*.exe
!bin/*.exe
# python311.zip = biblioteca estándar de Python embebido. SIN esto el
# Python no arranca en producción (ModuleNotFoundError: 'encodings').
!python-embed/python311.zip

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Tests / coverage
coverage/

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
dist-standalone/
