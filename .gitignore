# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node / dependencies
node_modules/
.pnp*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
out/
# NO ignoramos `build/` — nuestra carpeta build/ contiene assets de instalador
# NSIS que electron-builder necesita (package.json → nsis.include apunta a
# `build/installer.nsh`). Outputs de empaquetado van a dist/, no a build/.
release/
tmp/
temp/
.cache/
.parcel-cache/
*-unpacked/

# Electron packaging artifacts
*.AppImage
*.dmg
*.exe
*.msi
*.pkg
*.deb
*.rpm
*.snap
*.flatpak
*.asar
*.blockmap


# Excepciones: binarios que SI van al repo porque son parte del bundle
!python-embed/**/*.exe
!bin/*.exe
# drivers/*.exe = instaladores de drivers de impresora (térmica, etiquetas, remover)
# que se bundlean para correrlos desde la configuración.
!drivers/*.exe
# python311.zip = biblioteca estándar de Python embebido. SIN esto el
# Python no arranca en producción (ModuleNotFoundError: 'encodings').
!python-embed/python311.zip
# IntTFHKA.exe = driver oficial HKA. SIN esto el servidor fiscal no
# encuentra el programa en producción ("Programa no encontrado").
!fiscal-server/IntTFHKA.exe
# Driver Verifone (P200) — se bundlea para instalarlo desde la app (Smart POS).
!drivers/verifone/**

# vpos-rest/ = distribución completa de Megasoft VPOS RESTService (~268MB con
# JRE embebido). SÍ se versiona: `extraResources` la copia al bundle y el runner
# de CI solo tiene lo que está en git — sin ella el instalador sale sin VPOS y
# la caja falla con "Distribución VPOS no encontrada". La negación va al FINAL
# del archivo, para ganarle a los patrones globales (*.exe, *.log, .env*).

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Tests / coverage
coverage/

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
dist-standalone/
!.env.local
!.env.prod

# Distribución VPOS: gana a los ignores globales de arriba (*.exe, *.log, .env*).
!vpos-rest/**

/.vscode
# Runtime empaquetado (fast updates) — se genera con make-runtime-archive.js
runtime-dist/
